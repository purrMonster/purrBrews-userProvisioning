# doser — copy to deploy/local.env, fill in, chmod 0600, never commit.
#
# NOTE ON THE FILENAME: the fleet's device-bridge tooling refuses any filename
# matching *.env.local*, so this is local.env / local.env.example — matching
# what the sieve stack already does.
#
# Decision D6: plain gitignored file at mode 0600, no SOPS+age. This holds the
# largest concentration of high-value credentials on the fleet. The compensating
# controls in docs/07 §4.2-4.4 are the mitigation and are NOT optional:
#   * dedicated svc-doser accounts on each target, not barista's own credentials
#   * a rehearsed rotation runbook
#   * egress restriction from silo

# ---- core -----------------------------------------------------------------
# Service URLs default to https://<subdomain>.${DOSER_DOMAIN}, using the exact
# subdomains published by sieve's pihole-dns-bootstrap.sh (HOST_TARGETS).
# Verified against that script on 2026-09-06:
#
#   sieve       (nothing doser talks to — lldap is NOT in DNS, see below)
#   silo        komodo, scrutiny, netalertx, homepage, speedtest
#   cellar      vault                       → Vaultwarden (Caddy, real HTTPS)
#   percolator  nextcloud, paperless, homeassistant
#   mochaPot    immich, vikunja, mealie, roundcube, actualbudget,
#               n8n, freshrss, stirlingpdf, musicassistant
#   roastery    jellyfin (moved 2026-09-05, NOT in DNS, see below)
#
# Note the exact names: "homeassistant" not "hass", "actualbudget" not
# "actual", "roundcube" not "mail". These are already the defaults.
DOSER_DOMAIN=example.invalid

# ---- node LAN IPs ---------------------------------------------------------
# TWO services have no split-horizon DNS entry at all, so their hostnames will
# never resolve. Both are reached by IP:port instead.
#
#   lldap    — runs on sieve but is not behind Traefik (known gap in the sieve
#              stack), so lldap.${DOMAIN} does not exist. Default port 17170.
#   jellyfin — moved to roastery 2026-09-05 and deliberately excluded from the
#              bootstrap's HOST_TARGETS; reached directly on the LAN.
#
# Set these (matching stacks/sieve/.env.local's own SIEVE_LAN_IP), or set the
# full DOSER_LLDAP_URL / DOSER_JELLYFIN_URL below instead.
DOSER_SIEVE_LAN_IP=
DOSER_ROASTERY_LAN_IP=

DOSER_DATABASE_URL=postgresql+asyncpg://doser:CHANGE_ME@doser-db:5432/doser
DOSER_DB_PASSWORD=CHANGE_ME
DOSER_LOG_LEVEL=INFO

# ---- auth (docs/07 §2.2) --------------------------------------------------
# The docker network CIDR that Traefik reaches this container from. Requests
# from anywhere else are refused even if they carry valid-looking Remote-*
# headers. Get this from: docker network inspect silo_proxy
DOSER_TRUSTED_PROXY_CIDRS=172.18.0.0/16
DOSER_REQUIRED_GROUP=purrbrews_infra_admins

# Loopback-only development bypass. Never true on silo.
DOSER_DEV_AUTH_BYPASS=false

# Signs one-time enrolment links. openssl rand -hex 32
DOSER_ENROLMENT_SIGNING_KEY=CHANGE_ME

# ---- lldap (source of truth — required) ----------------------------------
# Derived as http://${DOSER_SIEVE_LAN_IP}:17170 when SIEVE_LAN_IP is set.
# Override here only if lldap is somewhere else or on a different port.
# DOSER_LLDAP_URL=http://192.168.x.x:17170
# DOSER_LLDAP_PORT=17170
DOSER_LLDAP_ADMIN_USER=admin
DOSER_LLDAP_ADMIN_PASSWORD=
DOSER_LLDAP_DEFAULT_GROUP=purrbrews_users

# ---- user-facing targets --------------------------------------------------
# A connector with no credential is DISABLED and shown as disabled on the
# /connectors screen. It never silently no-ops.

# Immich — real admin API; pre-creation buys quota + storage label.
DOSER_IMMICH_API_KEY=
DOSER_IMMICH_QUOTA_GB=50

# Vaultwarden — invitation only, by design. Needs the admin page enabled and
# INVITATIONS_ALLOWED not set to false.
DOSER_VAULTWARDEN_ADMIN_TOKEN=

# Nextcloud — "ldap" (recommended: user_ldap, no writes) or "ocs" (pre-create).
# NEVER both: an OCS-created local account shadows the LDAP one.
DOSER_NEXTCLOUD_MODE=ldap
# In "ldap" mode these are OPTIONAL — nothing is written with them, they are
# only used (read-only, via the Provisioning API) so doser can confirm a
# person's first login automatically instead of you checking by hand. In
# "ocs" mode they are required, as before.
DOSER_NEXTCLOUD_ADMIN_USER=
DOSER_NEXTCLOUD_ADMIN_PASSWORD=
DOSER_NEXTCLOUD_QUOTA=50 GB

# Home Assistant — "oidc_jit" (decision D5, production) or "local_ws" (TESTING
# ONLY: undocumented internal WebSocket API, mints a password, can break on any
# HA upgrade).
#   local_ws:  HASS_TOKEN is REQUIRED — it is how the account gets created.
#   oidc_jit:  HASS_TOKEN is OPTIONAL and changes nothing about creation (doser
#              still holds no HA credentials by default, per D5). Set it only
#              if you want doser to confirm a first login automatically — a
#              long-lived access token, used strictly read-only against HA's
#              internal auth/list API.
DOSER_HASS_MODE=oidc_jit
DOSER_HASS_TOKEN=

# Tier A/B services — no credentials needed; accounts appear on first login.
# All resolve via split-horizon DNS, so no URL needed:
#   vikunja.${DOMAIN}  mealie.${DOMAIN}  paperless.${DOMAIN}
#   actualbudget.${DOMAIN}  homeassistant.${DOMAIN}  nextcloud.${DOMAIN}
#
# EXCEPT Jellyfin, which is on roastery and not in DNS. Either set
# DOSER_ROASTERY_LAN_IP above (gives http://<ip>:8096) or the full URL here.
# DOSER_JELLYFIN_URL=http://192.168.x.x:8096

# These three are all OPTIONAL and all the same shape: none of them are needed
# for the account to appear on first login, but if you set them, doser will
# use them (read-only) to confirm that login automatically on reconcile
# instead of you checking each app by hand. Leave any of them blank and that
# service just stays "awaiting first login" until you check it yourself.
#   Vikunja:   Settings → API Tokens, in the Vikunja UI
#   Mealie:    an ADMIN account's token, under /user/profile/api-tokens
#   Paperless: My Profile → API token, in the Paperless UI
DOSER_VIKUNJA_TOKEN=
DOSER_MEALIE_TOKEN=
DOSER_PAPERLESS_TOKEN=
#
# Actual is the one exception: it has no public API for listing users at all
# (only an npm package for its own sync client), so doser cannot confirm this
# one automatically no matter what you set. Check Actual → Settings → User
# Directory by hand after the person's first login.

# Roundcube resolves at roundcube.${DOMAIN} on mochaPot, but it has no user
# store of its own — it authenticates against IMAP. Set MAIL_BACKEND only once
# a mail server exists; until then provisioning it is a documented no-op.
# DOSER_MAIL_BACKEND=

# ---- alerts ---------------------------------------------------------------
# ntfy on ristretto: one-way publish only. doser holds no ntfy credentials and
# never reaches ristretto for provisioning (decision D12).
# DOSER_NTFY_URL=
# DOSER_NTFY_TOPIC=purrbrews-doser

# ---- engine ---------------------------------------------------------------
DOSER_WORKER_CONCURRENCY=4
DOSER_RECONCILE_INTERVAL_SECONDS=3600
DOSER_VERIFY_TLS=true
